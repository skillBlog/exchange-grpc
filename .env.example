# Shared
JWT_SECRET=dev-exchange-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
LOG_LEVEL=info
# LOG_LEVEL_ADDR=:9090
# OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
# OTEL_SERVICE_NAME=
# Tracing: otelgrpc + otelpgx + redisotel + business spans.
# Безопасные атрибуты спана: user_id, market_id/market.id, order_id/order.id, request_id.
# Email и credentials на спаны не попадают.
# Без OTEL_EXPORTER_OTLP_ENDPOINT — noop (сервисы работают как раньше).
# Compose: Tempo :4317, Loki :3100 (Grafana не входит).

# Redis (login + create-order rate limits)
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=10
REDIS_MAX_RETRIES=3

# User
USER_SERVICE_ADDR=:50050
USER_DATABASE_URL=postgres://exchange:exchange@localhost:5432/userservice?sslmode=disable
USER_MIGRATIONS_DIR=migrations
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=1m

# Spot
SPOT_SERVICE_ADDR=:50051
SPOT_DATABASE_URL=postgres://exchange:exchange@localhost:5432/spotservice?sslmode=disable
SPOT_MIGRATIONS_DIR=migrations
MARKET_CACHE_TTL=30s
VIEW_MARKETS_RATE_LIMIT=30

# Order
ORDER_SERVICE_ADDR=:50052
SPOT_SERVICE_HOST=localhost:50051
ORDER_DATABASE_URL=postgres://exchange:exchange@localhost:5432/orderservice?sslmode=disable
ORDER_MIGRATIONS_DIR=migrations
SPOT_GRPC_TIMEOUT=5s
ORDER_HUB_BUFFER_SIZE=256
